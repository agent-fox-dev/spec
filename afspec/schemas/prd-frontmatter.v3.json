{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-fox.dev/schemas/prd-frontmatter.v3.json",
  "title": "PRD Frontmatter",
  "description": "Schema for the YAML frontmatter block in prd.md (format version 3)",
  "type": "object",
  "properties": {
    "spec_id": { "type": "string", "minLength": 1 },
    "spec_name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "active", "sealed", "superseded", "archived"] },
    "created_at": { "type": "string", "minLength": 1 },
    "intent_hash": { "type": ["string", "null"] },
    "schema_version": { "type": "integer", "const": 3 },
    "profile": { "type": "string", "enum": ["full", "lite"], "description": "The package's profile. A lite package has at most three requirements and no execution path, so no smoke check and no integration task. Absent means full." },
    "steering_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "source": { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["spec_id", "spec_name", "title", "status", "created_at", "intent_hash", "schema_version"],
  "patternProperties": { "^x-": { "description": "An extension key: a team's own metadata, any value, kept by every save. The format gives it no meaning." } },
  "additionalProperties": false
}
