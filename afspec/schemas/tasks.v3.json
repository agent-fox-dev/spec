{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-fox.dev/schemas/tasks.v3.json",
  "title": "Tasks",
  "description": "Schema for tasks.json spec artifact (format version 3)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "spec_id": { "type": "string", "minLength": 1 },
    "spec_name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "const": 3 },
    "test_commands": { "$ref": "#/$defs/test_commands" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" },
      "minItems": 1,
      "description": "The implement tasks, in order. The integration task is derived from the package and is not stored."
    }
  },
  "required": ["$schema", "spec_id", "spec_name", "schema_version", "test_commands", "dependencies", "tasks"],
  "patternProperties": { "^x-": { "description": "An extension key: a team's own metadata, any value, kept by every save. The format gives it no meaning." } },
  "additionalProperties": false,
  "$defs": {
    "test_commands": {
      "type": "object",
      "properties": {
        "all_tests": { "type": "string", "minLength": 1 },
        "linter": { "type": "string", "minLength": 1 },
        "spec_tests": { "type": "string", "minLength": 1 },
        "affected_tests": { "type": "string", "minLength": 1, "description": "The command that runs the tests a change can affect, with the placeholder {base} exactly once for the commit the change starts from." }
      },
      "required": ["all_tests", "linter"],
      "patternProperties": { "^x-": { "description": "An extension key: a team's own metadata, any value, kept by every save. The format gives it no meaning." } },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "spec": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["spec", "reason"],
      "patternProperties": { "^x-": { "description": "An extension key: a team's own metadata, any value, kept by every save. The format gives it no meaning." } },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": { "type": "string", "pattern": "^REQ-[0-9]+(\\.[0-9]+)?$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "The requirement and criterion ids the task satisfies. A requirement id means all of its criteria."
        },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "touches": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "depends_on": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "takes_handoffs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+:H-[0-9]+$" }, "minItems": 1, "uniqueItems": true, "description": "The handoffs this task takes, each as the sending package's spec id, a colon and the handoff's id." },
        "done_when": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["id", "title", "criteria", "steps"],
      "patternProperties": { "^x-": { "description": "An extension key: a team's own metadata, any value, kept by every save. The format gives it no meaning." } },
      "additionalProperties": false
    }
  }
}
